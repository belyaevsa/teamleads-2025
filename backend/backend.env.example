# Copy to `backend.env` (gitignored) and fill in. Loaded via `docker run --env-file`.
# Double-underscore maps to nested config keys (ConnectionStrings:Default).

ASPNETCORE_ENVIRONMENT=Production

# Remote PostgreSQL. Use SSL in production.
ConnectionStrings__Default=Host=YOUR_DB_HOST;Port=5432;Database=teamleads;Username=teamleads;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# Shared secret for the admin moderation endpoints (X-Api-Key header).
ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM

# Salt for hashing client IPs and telegram user ids (abuse triage without storing
# raw identifiers). Leave empty to store no hash at all.
IP_HASH_SALT=CHANGE_ME_RANDOM

# ── Anonymous requests bot (@temlead_helper_bot, «Падаван») ──────────────────
# All four are required for the feature; with any of them empty the webhook 404s
# and /api/anon still stores requests, they just never reach the admin chat.

# BotFather token.
TG_BOT_TOKEN=CHANGE_ME

# Random string used twice: as the webhook path suffix and as the
# X-Telegram-Bot-Api-Secret-Token header. Generate with `openssl rand -hex 24`.
TG_WEBHOOK_SECRET=CHANGE_ME_RANDOM

# Chat ids are NOT here – they live in the Settings table (tg.admin_chat_id,
# tg.community_chat_id), seeded by a migration and changeable at runtime with
# `/set` in the admin chat or PUT /api/settings/<key>. Moving the moderation group
# or migrating the community to a new supergroup must not require a redeploy.

# ── Archive feed + weekly dilemma ───────────────────────────────────────────
# Where the bot reads site content from. Both services run on the same host, so
# the local path is the default choice: no network, fresh the moment a landing
# deploy lands. Falls back to BOT_DATA_URL when unset.
BOT_DATA_PATH=/opt/teamleads.kz/latest/bot-data.json
BOT_DATA_URL=https://teamleads.kz/bot-data.json

# The scheduler switch and the dilemma slot are NOT env vars – they live in the
# Settings table, seeded on startup and editable at runtime (`/set` in the admin chat,
# or PUT /api/settings/<key>). Nothing posts to the chat until tg.scheduler.enabled
# is set to true there. Secrets stay here and are never stored in the table – see README.
